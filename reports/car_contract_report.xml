<odoo>
    <template id="report_car_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .contract-title { text-align: center; margin-bottom: 10px; }
                            .contract-title h1 { font-size: 24px; letter-spacing: 2px; text-transform: uppercase; color: #2c3e50; }
                            .contract-ref { text-align: center; color: #7f8c8d; margin-bottom: 30px; }
                            .section-title { background-color: #f5f5f5; padding: 6px 10px; font-weight: bold; margin-top: 20px; margin-bottom: 10px; border-left: 3px solid #714B67; }
                            .info-table td { padding: 4px 8px; vertical-align: top; }
                            .info-table td.label { font-weight: bold; width: 25%; color: #555; }
                            .terms { font-size: 11px; color: #555; line-height: 1.5; margin-top: 25px; }
                            .signature-box { margin-top: 60px; }
                            .signature-line { border-top: 1px solid #333; width: 200px; margin-top: 50px; }
                        </style>

                        <div class="contract-title">
                            <h1>Car Rental Agreement</h1>
                        </div>
                        <div class="contract-ref">
                            Contract Reference: <span t-field="doc.registration_number"/>
                        </div>

                        <div class="section-title">Agency</div>
                        <table class="info-table" style="width:100%;">
                            <tr>
                                <td class="label">Agency Responsible</td>
                                <td><span t-field="doc.agency_id.responsible_id.name"/></td>
                                <td class="label">Contact</td>
                                <td><span t-field="doc.agency_id.responsible_id.phone"/></td>
                            </tr>
                        </table>

                        <div class="section-title">Customer</div>
                        <table class="info-table" style="width:100%;">
                            <tr>
                                <td class="label">Full Name</td>
                                <td><span t-field="doc.customer_id.name"/></td>
                                <td class="label">CIN</td>
                                <td><span t-field="doc.customer_id.cin"/></td>
                            </tr>
                            <tr>
                                <td class="label">Phone</td>
                                <td><span t-field="doc.customer_id.phone"/></td>
                                <td class="label">Email</td>
                                <td><span t-field="doc.customer_id.email"/></td>
                            </tr>
                        </table>

                        <div class="section-title">Vehicle</div>
                        <table class="info-table" style="width:100%;">
                            <tr>
                                <td class="label">Brand / Model</td>
                                <td><span t-field="doc.brand_id.name"/></td>
                                <td class="label">Registration Number</td>
                                <td><span t-field="doc.registration_number"/></td>
                            </tr>
                            <tr>
                                <td class="label">Mileage</td>
                                <td><span t-field="doc.mileage"/> km</td>
                                <td class="label">Status</td>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                        </table>

                        <div class="section-title">Rental Period</div>
                        <table class="info-table" style="width:100%;">
                            <tr>
                                <td class="label">Start Date</td>
                                <td><span t-field="doc.start_date"/></td>
                                <td class="label">End Date</td>
                                <td><span t-field="doc.end_date"/></td>
                            </tr>
                        </table>

                        <p class="terms">
                            By signing below, the customer acknowledges having received the above-described vehicle
                            in good working condition and agrees to return it on the end date at the agency's premises,
                            in the same condition, subject to normal wear. Any damage, delay, or loss shall be the
                            customer's responsibility as per the agency's rental policy.
                        </p>

                        <div class="row signature-box">
                            <div class="col-6">
                                Agency Representative
                                <div class="signature-line"/>
                            </div>
                            <div class="col-6">
                                Customer Signature
                                <div class="signature-line"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>