<odoo>
    <record id="car_rental_view_form" model="ir.ui.view">
        <field name="name">car.rental.form</field>
        <field name="model">car.rental</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Done" type="object"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Canel" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="car_id"/>
                        <field name="customer_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_rental_view_tree" model="ir.ui.view">
        <field name="name">car.rental.tree</field>
        <field name="model">car.rental</field>
        <field name="arch" type="xml">
            <list>
                <field name="car_id"/>
                <field name="customer_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_car_rental" model="ir.actions.act_window">
        <field name="name" >Car Rentals</field>
        <field name="res_model">car.rental</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_car_rental" name="Car Rentals" action="action_car_rental" sequence="10" />
</odoo>