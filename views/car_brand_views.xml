<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_car_brand_list" model="ir.ui.view">
        <field name="name">car.brand.list</field>
        <field name="model">car.brand</field>
        <field name="arch" type="xml">
            <list string="Car Brands">
                <field name="name"/>
                <field name="agency_id"/>
                <field name="car_count"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_car_brand_form" model="ir.ui.view">
        <field name="name">car.brand.form</field>
        <field name="model">car.brand</field>
        <field name="arch" type="xml">
            <form string="Car Brand">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Toyota"/>
                        </h1>
                    </div>
                    <group>
                        <field name="agency_id"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Brand description..."/>
                        </page>
                        <page string="Cars">
                            <field name="car_ids">
                                <list>
                                    <field name="registration_number"/>
                                    <field name="mileage"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_car_brand_search" model="ir.ui.view">
        <field name="name">car.brand.search</field>
        <field name="model">car.brand</field>
        <field name="arch" type="xml">
            <search string="Search Car Brands">
                <field name="name"/>
                <field name="agency_id"/>
                <separator string="Group By"/>
                <group>
                    <filter string="Agency" name="group_agency" context="{'group_by': 'agency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_car_brand" model="ir.actions.act_window">
        <field name="name">Car Brands</field>
        <field name="res_model">car.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_car_brand_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first car brand
            </p>
        </field>
    </record>

</odoo>
