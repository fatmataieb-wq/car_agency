<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_cars" name="My Cars">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" value="car"/>
            <div class="o_portal_my_home">
                <h3>My rented cars</h3>
                <table class="table table-striped" t-if="cars">
                    <thead>
                        <tr>
                            <th>Registration number</th>
                            <th>Brand</th>
                            <th>Status</th>
                            <th>Start date</th>
                            <th>End date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="cars" t-as="car">
                            <td><t t-esc="car.registration_number"/></td>
                            <td><t t-esc="car.brand_id.name"/></td>
                            <td><t t-esc="car.state"/></td>
                            <td><t t-esc="car.start_date"/></td>
                            <td><t t-esc="car.end_date"/></td>
                        </tr>
                    </tbody>
                </table>
                <p t-else="">You have no rented cars.</p>
            </div>
        </t>
    </template>

    <template id="portal_my_home_car_agency" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/car_agency/static/description/icon.png'"/>
                <t t-set="title">My cars</t>
                <t t-set="text">See the cars you've rented</t>
                <t t-set="url" t-value="'/my/cars'"/>
                <t t-set="placeholder_count" t-value="'car_count'"/>
            </t>
        </xpath>
    </template>

</odoo>